__pycache__/
*.pyc
.venv/
venv/

# Credenciales — NUNCA deben subirse. El token real vive fuera del repo,
# en /home/claude/.query_api_token (o en la variable de entorno
# QUERY_API_TOKEN), y así se queda.
.query_api_token
*.token
.env

# Salidas de datos: contienen cifras contables/fiscales reales de Trivasa
# (montos, RFC, folios). Se regeneran corriendo los scripts — no se versionan.
output/
*.xlsx
*.parquet
!docs/**/*.xlsx
