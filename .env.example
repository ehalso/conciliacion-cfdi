# Plantilla de credenciales para conexión DIRECTA a las bases de Trivasa
# (ver src/bridge_client.py). Copiar a `.env` (gitignored, nunca se sube) y
# llenar los valores reales. Host/puerto/base van hardcodeados en
# bridge_client.py — no son secreto — solo hace falta usuario/password.

# Postgres (raw_sat / trivasa_dw) — rol de solo lectura ealcocer_ro
PG_HOST=192.168.117.14
PG_PORT=5433
PG_DATABASE=trivasa_dw
PG_USER=
PG_PASSWORD=

# SQL Server .205 (TRIVASADB3 en SVRMPRO — instancia alterna, ver src/config.py)
MSSQL_205_USER=
MSSQL_205_PASSWORD=

# SQL Server .207 (TRIVASADB en BACK-MPRO — instancia autoritativa/producción)
MSSQL_207_USER=
MSSQL_207_PASSWORD=
